# STONKBOT configuration.
# Copy to .env and fill in. Never commit .env — it holds live secrets.
# Every variable below also works without the STONKBOT_ prefix.

# === Safety ===================================================================
# SENSITIVE BEHAVIOUR. Leave true until you have tested end to end.
# When false, launches spend real SOL from real user wallets.
STONKBOT_DRY_RUN=true

# === STONKBOT service fee (this is OUR fee, not StonkFun's) ==================
STONKBOT_SERVICE_FEE_SOL=0.1
# Operator wallet that receives the service fee. Public address, not a secret.
STONKBOT_FEE_RECIPIENT=GKCJKSDJMfq4Zm4ye16oQFHRxqVqParBPvA5ja3FPBzS
# Share of the service fee rebated to a referrer (0.30 = 30%).
STONKBOT_REFERRAL_SHARE=0.30

# === Launch cost guard rails =================================================
# StonkFun does not publish a fixed launch price — the real cost is quoted per
# launch inside the payment transaction from /launches/prepare. STONKBOT reads
# that quote at launch time. These two values only bound it.
#
# SECURITY CONTROL: refuse to sign any payment transaction that would move more
# than this much SOL out of a user's wallet. Keep it tight.
STONKBOT_MAX_LAUNCH_COST_SOL=1.0
# Headroom kept for Solana network fees and rent on top of the quoted cost.
STONKBOT_NETWORK_FEE_RESERVE_SOL=0.02
# Funding figure shown in guidance copy. Not used to authorise a launch.
STONKBOT_RECOMMENDED_FUNDING_SOL=0.35

# === Vault (SECRET) ==========================================================
# Encrypts every user's agent wallet secret key at rest.
# Must be 32+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# LOSING THIS KEY MAKES EVERY USER WALLET PERMANENTLY UNRECOVERABLE.
# CHANGING IT HAS THE SAME EFFECT. Back it up in a secret manager.
AGENT_VAULT_KEY=

# === Solana ==================================================================
# The public endpoint is heavily rate limited; use a dedicated provider in
# production. If the URL embeds an API key, treat this whole value as a secret.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
STONKBOT_RPC_TIMEOUT_SECONDS=20

# === StonkFun ================================================================
# Public API. No key exists or is required.
STONKFUN_API_BASE=https://www.stonkfun.xyz/api/public/v1

# === X / Twitter (ALL SECRET except the username) ============================
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
# The bot's own handle, without '@'. Advisory only: the poll loop trusts the
# handle the access token actually authenticates as, and warns on a mismatch.
# Set it anyway as a tripwire against wiring up the wrong account.
X_BOT_USERNAME=StonkFunBot

# === Rails ===================================================================
STONKBOT_DAILY_LAUNCH_BUDGET=10
STONKBOT_RATE_LIMIT_PER_MIN=5
STONKBOT_USER_LAUNCHES_PER_HOUR=3

# === Storage =================================================================
# Two supported shapes, and DATABASE_URL alone decides which.
#
# 1. Long-running process (VPS, Railway, Fly, local): leave DATABASE_URL unset.
#    State is SQLite under STONKBOT_DATA_DIR, which MUST be a persistent volume
#    — it holds the encrypted wallet vault.
STONKBOT_DATA_DIR=data
#
# 2. Serverless (Vercel cron): set DATABASE_URL to a Postgres connection string.
#    Required there — function disks are ephemeral, so a SQLite vault would be
#    destroyed between invocations and the double-payment guard would stop
#    guarding. POSTGRES_URL (what the Vercel Postgres integration injects) is
#    accepted as an alias.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# === Cron endpoint (SECRET, serverless only) =================================
# Vercel sends this as a bearer token to /api/poll on each scheduled run.
# Unset means the endpoint refuses every request — it fails closed, because an
# open endpoint is a public button that makes the bot post.
# CRON_SECRET=
